* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.lua text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.init text eol=lf
Makefile text eol=lf
# Unified diff context and vendored sources preserve upstream whitespace.
*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
client/vendor/* whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
*.ico binary
*.png binary
