#include <windows.h>
#include "build_info.h"
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"
2 ICON "app.ico"
1 VERSIONINFO
FILEVERSION VPN_FILE_VERSION
PRODUCTVERSION VPN_FILE_VERSION
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", VPN_PRODUCT_NAME " - Native OpenConnect client\0"
   VALUE "FileVersion", VPN_VERSION "\0"
   VALUE "ProductName", VPN_PRODUCT_NAME "\0"
   VALUE "ProductVersion", VPN_VERSION "\0"
   VALUE "OriginalFilename", VPN_EXECUTABLE "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
