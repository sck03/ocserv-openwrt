#!/bin/sh /etc/rc.common
START=18
STOP=89
USE_PROCD=1

start_service() {
    # Independent of the transaction: expiry continues after disable/failure
    # and does not depend on a browser or on cron being enabled.
    procd_open_instance logs
    procd_set_param command /usr/bin/lua /usr/libexec/ocserv-easy-guard logs
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
    # Catch up when this package starts after ocserv/the proxy (e.g. upgrade).
    procd_open_instance proxy
    procd_set_param command /usr/bin/lua /usr/libexec/ocserv-easy-guard proxy
    procd_set_param term_timeout 150
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
    [ -f /etc/ocserv/easy-guard/state.json ] || [ -f /etc/ocserv/easy-transaction/state.json ] || return 0
    procd_open_instance worker
    procd_set_param command /usr/bin/lua /usr/libexec/ocserv-easy-guard
    procd_set_param term_timeout 150
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

service_triggers() {
    # OpenWrt 25.12 emits instance.start only as a ubus notification, not
    # an internal trigger. instance.update reaches triggers with EMPTY data;
    # filtering it by service name would silently discard every event.
    # procd coalesces the command; the worker skips unchanged configurations.
    procd_open_trigger
    procd_add_raw_trigger "instance.update" 3000 /usr/bin/lua /usr/libexec/ocserv-easy-guard proxy
    procd_close_trigger
}

boot() {
    # A pending transaction is restored before fw4 starts after a power failure.
    /usr/bin/lua /usr/libexec/ocserv-easy-guard boot
    start
}
