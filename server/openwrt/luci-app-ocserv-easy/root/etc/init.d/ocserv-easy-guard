#!/bin/sh /etc/rc.common
START=18
STOP=89
USE_PROCD=1

start_service() {
    # Independent of the transaction: expiry continues after disable/failure
    # and does not depend on a browser or on cron being enabled.
    procd_open_instance logs
    procd_set_param command /usr/bin/lua /usr/libexec/ocserv-easy-guard logs
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
    [ -f /etc/ocserv/easy-guard/state.json ] || [ -f /etc/ocserv/easy-transaction/state.json ] || return 0
    procd_open_instance worker
    procd_set_param command /usr/bin/lua /usr/libexec/ocserv-easy-guard
    procd_set_param term_timeout 150
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

service_triggers() {
    # One-shot repair after VPN/proxy startup, respawn or package upgrade.
    # Filter service events; no extra daemon or recurring proxy polling.
    procd_open_trigger
    local service
    for service in ocserv nikki momo; do
        json_add_array ""
        json_add_string "" "instance.start"
        json_add_array ""
        json_add_string "" "if"
        json_add_array ""
        json_add_string "" "eq"
        json_add_string "" "service"
        json_add_string "" "$service"
        json_close_array
        json_add_array ""
        json_add_string "" "run_script"
        json_add_string "" "/usr/bin/lua"
        json_add_string "" "/usr/libexec/ocserv-easy-guard"
        json_add_string "" "proxy"
        json_close_array
        json_close_array
        json_add_int "" 3000
        json_close_array
    done
    procd_close_trigger
}

boot() {
    # A pending transaction is restored before fw4 starts after a power failure.
    /usr/bin/lua /usr/libexec/ocserv-easy-guard boot
    start
}
