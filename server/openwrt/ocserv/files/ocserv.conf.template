# Managed OpenWrt ocserv template. Configure the supported fields in UCI;
# put additional directives in /etc/ocserv/ocserv.conf.local.
# Full option reference: https://ocserv.openconnect-vpn.net/ocserv.8.html
auth = "|AUTH|"
banner = "Welcome to OpenWRT"
# Re-resolve the hostname on reconnect, including DDNS managed upstream.
listen-host-is-dyndns = |DYNDNS|
max-clients = |MAX_CLIENTS|
rate-limit-ms = 100
max-same-clients = |MAX_SAME|
tcp-port = |PORT|
|UDP|udp-port = |UDP_PORT|
server-stats-reset-time = 604800
keepalive = 32400
dpd = |DPD|
mobile-dpd = 1800
switch-to-tcp-timeout = 25
# TCP fallback remains available when a NAT mapping or UDP path is lost.
try-mtu-discovery = false
server-cert = |SERVER_CERT|
server-key = |SERVER_KEY|
|COMPRESSION|compression = true
tls-priorities = "NORMAL:%SERVER_PRECEDENCE:%COMPAT:-VERS-SSL3.0"
auth-timeout = 240
min-reauth-time = 360
max-ban-score = 80
ban-reset-time = 1200
cookie-timeout = 300
deny-roaming = false
rekey-time = 172800
rekey-method = ssl
use-utmp = false
use-occtl = true
occtl-socket-file = /var/run/occtl.socket
pid-file = /var/run/ocserv.pid
chroot-dir = /var/lib/ocserv
socket-file = ocserv-socket
run-as-user = ocserv
run-as-group = ocserv
device = vpns
# DNS and routes from UCI are appended by the init script.
predictable-ips = |PREDICTABLE_IPS|
|ENABLE_DEFAULT_DOMAIN|default-domain = |DEFAULT_DOMAIN|
ipv4-network = |IPV4ADDR|
ipv4-netmask = |NETMASK|
|ENABLE_IPV6|ipv6-network = |IPV6ADDR|
|ENABLE_SPLIT_DNS|split-dns = |DEFAULT_DOMAIN|
ping-leases = |PING_LEASES|
config-per-user = /etc/ocserv/config-per-user/
config-per-group = /etc/ocserv/config-per-group/
route-add-cmd = "/sbin/route add -net %{RI} dev %{D}"
route-del-cmd = "/sbin/route del -net %{RI} dev %{D}"
cisco-client-compat = |CISCO_COMPAT|
expose-iroutes = true
client-bypass-protocol = false
camouflage = false
camouflage_secret = "mysecretkey"
camouflage_realm = "Restricted Content"
included-http-headers = Strict-Transport-Security: max-age=31536000 ; includeSubDomains
included-http-headers = X-Frame-Options: deny
included-http-headers = X-Content-Type-Options: nosniff
included-http-headers = Content-Security-Policy: default-src 'none'
included-http-headers = X-Permitted-Cross-Domain-Policies: none
included-http-headers = Referrer-Policy: no-referrer
included-http-headers = Clear-Site-Data: "cache","cookies","storage"
included-http-headers = Cross-Origin-Embedder-Policy: require-corp
included-http-headers = Cross-Origin-Opener-Policy: same-origin
included-http-headers = Cross-Origin-Resource-Policy: same-origin
included-http-headers = X-XSS-Protection: 0
included-http-headers = Pragma: no-cache
included-http-headers = Cache-control: no-store, no-cache
