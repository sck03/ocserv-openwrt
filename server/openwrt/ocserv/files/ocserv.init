#!/bin/sh /etc/rc.common

START=50
USE_PROCD=1
EXTRA_COMMANDS="initcerts"
EXTRA_HELP="        initcerts  Generate missing server certificates without starting VPN"

. "${IPKG_INSTROOT:-}/lib/functions/network.sh"

initcerts() (
	# OpenWrt's UCI/network helpers read optional, unset variables.  They are
	# not nounset-safe; do not enable `set -u` around config_load/network_get_*.
	# Check writes explicitly: start_service calls us in an OR-list, where the
	# shell disables errexit even inside this subshell.
	set +u
	umask 077
	config_load ocserv || exit 1
	config_get certificate config server_cert "/etc/ocserv/server-cert.pem"
	config_get private_key config server_key "/etc/ocserv/server-key.pem"
	if [ "$certificate" != /etc/ocserv/server-cert.pem ] || [ "$private_key" != /etc/ocserv/server-key.pem ]; then
		# ACME/external certificates do not depend on the bootstrap CA or its key.
		[ -s "$certificate" ] && [ -s "$private_key" ] && exit 0
		logger -t ocserv 'The configured server certificate or private key is missing or empty'
		exit 1
	fi
	command -v certtool >/dev/null 2>&1 || { logger -t ocserv 'certtool is missing'; exit 1; }
	mkdir -p /etc/ocserv/pki && chmod 700 /etc/ocserv/pki || exit 1
	if [ -s /etc/ocserv/server-key.pem ] && [ -s /etc/ocserv/server-cert.pem ]; then
		chmod 600 /etc/ocserv/server-key.pem || exit 1
		[ ! -f /etc/ocserv/ca-key.pem ] || chmod 600 /etc/ocserv/ca-key.pem || exit 1
		exit 0
	fi
	if [ -s /etc/ocserv/ca.pem ] && [ ! -s /etc/ocserv/ca-key.pem ]; then
		logger -t ocserv 'Existing CA has no private key; provide the matching server certificate instead of replacing this CA'
		exit 1
	fi
	hostname=$(uci -q get system.@system[0].hostname || true)
	hostname=$(printf '%s' "$hostname" | tr -cd 'A-Za-z0-9.-')
	[ -n "$hostname" ] || hostname=OpenWrt
	lan_address=''
	network_get_ipaddr lan_address lan || true
	workspace=$(mktemp -d /etc/ocserv/pki/init.XXXXXX) || exit 1
	trap 'rm -rf -- "$workspace"' EXIT
	generate() {
		certtool "$@" >/dev/null 2>&1 || {
			logger -t ocserv 'Certificate generation failed; check certtool, free space and system time'
			exit 1
		}
	}
	if [ ! -s /etc/ocserv/ca-key.pem ]; then
		generate --bits 3072 --generate-privkey --outfile "$workspace/ca-key.pem"
		mv "$workspace/ca-key.pem" /etc/ocserv/ca-key.pem || exit 1
	fi
	if [ ! -s /etc/ocserv/ca.pem ]; then
		printf 'cn="%s CA"\nexpiration_days=3650\nca\ncert_signing_key\ncrl_signing_key\n' "$hostname" >"$workspace/ca.tmpl" || exit 1
		generate --template "$workspace/ca.tmpl" --generate-self-signed \
			--load-privkey /etc/ocserv/ca-key.pem --outfile "$workspace/ca.pem"
		mv "$workspace/ca.pem" /etc/ocserv/ca.pem || exit 1
	fi
	if [ ! -s /etc/ocserv/server-key.pem ]; then
		generate --bits 3072 --generate-privkey --outfile "$workspace/server-key.pem"
		mv "$workspace/server-key.pem" /etc/ocserv/server-key.pem || exit 1
	fi
	if [ ! -s /etc/ocserv/server-cert.pem ]; then
		printf 'cn="%s"\ndns_name="%s"\nexpiration_days=825\nsigning_key\nencryption_key\ntls_www_server\n' "$hostname" "$hostname" >"$workspace/server.tmpl" || exit 1
		case "$lan_address" in ''|*[!0-9.]*) ;; *) printf 'ip_address="%s"\n' "$lan_address" >>"$workspace/server.tmpl" || exit 1;; esac
		generate --template "$workspace/server.tmpl" --generate-certificate \
			--load-privkey /etc/ocserv/server-key.pem --load-ca-certificate /etc/ocserv/ca.pem \
			--load-ca-privkey /etc/ocserv/ca-key.pem --outfile "$workspace/server-cert.pem"
		mv "$workspace/server-cert.pem" /etc/ocserv/server-cert.pem || exit 1
	fi
	chmod 600 /etc/ocserv/ca-key.pem /etc/ocserv/server-key.pem
)

start_service() {
	initcerts || return 1
	/usr/libexec/ocserv-render || return 1

	[ -f /var/run/ocserv.pid ] || {
		touch /var/run/ocserv.pid && chown ocserv:ocserv /var/run/ocserv.pid || return 1
	}
	[ -d /var/lib/ocserv ] || {
		mkdir -m 0700 -p /var/lib/ocserv &&
			chown ocserv:ocserv /var/lib/ocserv || return 1
	}

	procd_open_instance
	procd_set_param command /usr/sbin/ocserv -s -f -c /var/etc/ocserv.conf
	procd_set_param respawn
	procd_close_instance
}

boot() {
	# The early recovery service must finish before derived runtime is rebuilt.
	[ ! -e /etc/ocserv/easy-transaction/state.json ] || return 1
	start
}
