# Example /etc/config/ocserv for this N1. Merge into the existing file after backup.
# Accounts are managed separately in LuCI; this file contains no credentials.
config ocserv 'config'
    option port '4443'
    option udp '1'
    option udp_port '4443'
    option enable '1'
    option zone 'vpn'
    option auth 'plain'
    option max_clients '32'
    option max_same '1'
    option dpd '60'
    option ipaddr '10.77.0.0'
    option netmask '255.255.255.0'
    option proxy_arp '0'
    option compression '0'
    option server_cert '/etc/ocserv/server-cert.pem'
    option server_key '/etc/ocserv/server-key.pem'

config dns
    option ip '10.77.0.1'

# No "config routes" entries => advertise the default route.
# Configure dnsmasq/OpenClash to answer authenticated VPN clients on 10.77.0.1.
